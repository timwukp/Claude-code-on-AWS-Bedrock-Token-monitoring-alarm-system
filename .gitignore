# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
cdk.out/
*.tsbuildinfo

# CDK context cache — contains account-specific lookups (AZs etc.); never commit
cdk.context.json
**/cdk.context.json

# Env & secrets — never commit
.env
.env.local
.env.*.local
infra/lib/config/*.json
!infra/lib/config/example.env.json
!infra/lib/config/ci.json    # placeholder account (123456789012) for CI synth only — no secrets

# Python
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
