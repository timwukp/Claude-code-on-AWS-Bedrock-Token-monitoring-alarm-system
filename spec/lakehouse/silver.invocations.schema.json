{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tums.local/lakehouse/silver.invocations.schema.json",
  "title": "silver.invocations",
  "description": "One row per model invocation, vendor-neutral. Vocabulary follows the OpenTelemetry GenAI semantic conventions (gen_ai.*) plus AWS extensions; a Bedrock log record and an OTel span for the same request_id merge into one row. No request/response bodies.",
  "type": "object",
  "properties": {
    "event_ts": {
      "description": "call time (Bedrock record timestamp, else span start)",
      "type": "string",
      "format": "date-time"
    },
    "event_day": {
      "description": "UTC day (partition)",
      "type": "string"
    },
    "request_id": {
      "description": "Bedrock requestId == OTel aws.request_id / gen_ai.response.id; dedupe key",
      "type": "string"
    },
    "source": {
      "description": "bedrock | otel | both",
      "type": "string"
    },
    "operation": {
      "description": "Bedrock operation (InvokeModel, Converse, \u2026) or gen_ai.operation.name",
      "type": "string"
    },
    "api_family": {
      "description": "invoke | converse | openai_responses | openai_chat | embeddings | image | other",
      "type": "string"
    },
    "model_id_raw": {
      "description": "modelId exactly as logged",
      "type": "string"
    },
    "model_key": {
      "description": "normalised model key (parseModelId)",
      "type": "string"
    },
    "vendor": {
      "description": "gen_ai.provider.name-style vendor: anthropic, openai, amazon, meta, mistral, cohere, ai21, deepseek, moonshot, qwen, \u2026 or unknown",
      "type": "string"
    },
    "family": {
      "description": "model family",
      "type": "string"
    },
    "version": {
      "description": "model version/date, null if none",
      "type": "string"
    },
    "modality": {
      "description": "text | embedding | image | video | speech | unknown",
      "type": "string"
    },
    "route": {
      "description": "global | us | eu | apac | profile | provisioned | custom | imported | marketplace | direct",
      "type": "string"
    },
    "aip_arn": {
      "description": "application inference profile ARN when routed through one",
      "type": "string"
    },
    "underlying_model_id": {
      "description": "model behind a profile (registry), else model_key",
      "type": "string"
    },
    "identity_arn": {
      "description": "caller ARN as logged",
      "type": "string"
    },
    "tenant_key": {
      "description": "normalised tenant: user/<name> or role/<Role> (sessions collapsed)",
      "type": "string"
    },
    "caller_type": {
      "description": "user | role | api_key_user | service | unknown",
      "type": "string"
    },
    "project_id": {
      "description": "attributed project or untagged",
      "type": "string"
    },
    "attribution_source": {
      "description": "aip | identity | metadata | workspace | none",
      "type": "string"
    },
    "input_tokens": {
      "description": "gen_ai.usage.input_tokens (Bedrock envelope authoritative)",
      "type": "integer"
    },
    "output_tokens": {
      "description": "gen_ai.usage.output_tokens",
      "type": "integer"
    },
    "cache_read_tokens": {
      "description": "aws.bedrock.cache_read_tokens",
      "type": "integer"
    },
    "cache_write_tokens": {
      "description": "aws.bedrock.cache_write_tokens",
      "type": "integer"
    },
    "cache_write_ttl": {
      "description": "5m | 1h | 30m | unknown",
      "type": "string"
    },
    "reasoning_tokens": {
      "description": "adapter: reasoning/thinking output tokens when reported",
      "type": "integer"
    },
    "tool_calls": {
      "description": "adapter: number of tool/function calls in the response",
      "type": "integer"
    },
    "finish_reason": {
      "description": "gen_ai.response.finish_reasons (first)",
      "type": "string"
    },
    "latency_ms": {
      "description": "amazon-bedrock-invocationMetrics.invocationLatency or span duration",
      "type": "number"
    },
    "ttft_ms": {
      "description": "first-byte latency when reported",
      "type": "number"
    },
    "body_s3_path": {
      "description": "input body object when > 100 KB (bronze keeps the pointer; silver never reads it)",
      "type": "string"
    },
    "token_source": {
      "description": "envelope | adapter | otel",
      "type": "string"
    },
    "adapter_discrepancy": {
      "description": "true when the adapter disagreed with the envelope (see silver.adapter_audit)",
      "type": "boolean"
    },
    "price_status": {
      "description": "priced | unpriced_public | unpriced_private (from dim_model)",
      "type": "string"
    },
    "session_id": {
      "description": "OTel session.id when present",
      "type": "string"
    },
    "conversation_id": {
      "description": "OTel gen_ai.conversation.id when present",
      "type": "string"
    },
    "trace_id": {
      "description": "OTel trace id",
      "type": "string"
    },
    "span_id": {
      "description": "OTel span id",
      "type": "string"
    },
    "service_name": {
      "description": "OTel service.name (gateway / app)",
      "type": "string"
    },
    "ingest_ts": {
      "description": "emit time",
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_ts",
    "event_day",
    "request_id",
    "source",
    "model_id_raw",
    "model_key",
    "vendor",
    "tenant_key",
    "project_id",
    "attribution_source",
    "input_tokens",
    "output_tokens",
    "token_source",
    "ingest_ts"
  ],
  "additionalProperties": false,
  "x-lakehouse": {
    "layer": "silver",
    "table": "invocations",
    "storage": "s3tables",
    "partition": [
      "event_day"
    ],
    "retention": "forever",
    "pii": false
  }
}
